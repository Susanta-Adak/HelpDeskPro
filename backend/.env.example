# Copy this file to .env and fill in real values. .env is gitignored;
# this example file is committed as a template only — no real secrets here.

DATABASE_URL=sqlite:///./helpdeskpro.db

# Generate a real random value for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-this-is-a-dev-secret

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Bootstrap credentials for the one account `python -m app.db.seed` creates.
# Required — the seed script refuses to run without a password set, so one
# never lives in source. Create any further users from the admin console.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
